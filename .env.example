# Public browser-safe Supabase values for the Next.js frontend.
# Copy these two values to frontend/.env.local for local development.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server/admin-only values for local migration scripts.
# Do not expose these in the browser and do not commit real values.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional local path used by backup scripts only.
# Keep the referenced JSON outside Git.
FIREBASE_SERVICE_ACCOUNT=
